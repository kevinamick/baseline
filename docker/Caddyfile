# The Supabase client libraries address PostgREST as `<SUPABASE_URL>/rest/v1/...`; this is the
# one-route gateway that gives PostgREST that prefix. Nothing else is proxied: there is no
# auth service, no storage, no realtime in the self-hosted stack (ADR-0020).
:8000 {
	handle_path /rest/v1/* {
		reverse_proxy rest:3000
	}
	respond 404
}
