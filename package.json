{
  "name": "baseline",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n next,stripe,worker -c blue,magenta,green \"npm:dev:next\" \"npm:dev:stripe\" \"npm:dev:worker\"",
    "dev:next": "next dev",
    "dev:stripe": "stripe listen --forward-to localhost:3000/api/webhooks/stripe",
    "dev:worker": "npm run dev --prefix worker",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test --prefix worker",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.4.1",
    "@sentry/nextjs": "^10.53.1",
    "@stripe/stripe-js": "^9.6.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "next": "16.2.6",
    "posthog-js": "^1.376.0",
    "posthog-node": "^5.21.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.1.1",
    "svix": "^1.94.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
