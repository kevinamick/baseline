# Copy to `.env` for `docker compose up`. Only the LLM key(s) are required.

# LLM PROVIDER KEYS — at least one. Runs judge and optimize on these; a key saved under
# Settings → Provider keys in the app overrides the env var for that provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=

# Where optimization-run emails go (optional; needs RESEND_API_KEY + RESEND_FROM too).
OPTIMIZATION_NOTIFY_EMAIL=
RESEND_API_KEY=
RESEND_FROM=

# Local stack secrets. Fine as-is on your own machine; change them before exposing the
# stack to anyone else. TEMPORAL_ENCRYPTION_KEY is a base64 32-byte key shared by the app
# and the worker:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
POSTGRES_PASSWORD=postgres
TEMPORAL_ENCRYPTION_KEY=INWX/3SgQtxONdG8Mde9plFqGetp19jYLocX/qA0IGY=
WORKER_WAKE_SECRET=local-wake-secret
