# Copy this file to worker/.env.local and fill in the values.
#
# LOCAL SUPABASE (recommended for development)
# Run `npm run db:start` from the repo root, then copy the service_role key below.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=            # copy from `supabase start` output

# LLM — Anthropic is the default; add keys for any other providers you want to use (#204)
ANTHROPIC_API_KEY=sk-ant-...
LLM_PROVIDER=anthropic                  # startup default / logging — per-run provider is model-derived
# ANTHROPIC_MODEL=claude-opus-4-7     # optional override
# OPENAI_API_KEY=sk-...               # optional — enables OpenAI models for local runs
# GOOGLE_API_KEY=...                  # optional — enables Google models for local runs
# MISTRAL_API_KEY=...                 # optional — enables Mistral models for local runs
# GOOGLE_API_BASE_OVERRIDE=...        # optional — point the Google client at a mock/proxy host (dev/test only)

# EMAIL
# Two transports, mirroring the app (src/lib/email/send.ts):
#   - Production sends eval-run and optimization emails via Resend (set RESEND_API_KEY).
#   - Local dev routes them to Mailpit over SMTP instead, so mail is inspectable in the Mailpit UI
#     (http://127.0.0.1:54324) and never bounces seed/test recipients off the real Resend account.
# Setting MAILPIT_SMTP_HOST switches the worker to the dev SMTP path; leave it unset in production.
# 54325 is Supabase's local Mailpit smtp_port (supabase/config.toml [inbucket]). With this set, no
# RESEND_API_KEY is needed locally.
MAILPIT_SMTP_HOST=127.0.0.1
MAILPIT_SMTP_PORT=54325
RESEND_API_KEY=                       # production only; dev uses Mailpit SMTP above
RESEND_FROM=evals@yourdomain.com

# APP
APP_URL=http://localhost:3000

# TEMPORAL (REQUIRED — the sole executor for eval + optimization runs; ADR-0006, #123)
# Temporal is mandatory: the worker registers a Temporal worker unconditionally and refuses to
# run if it can't reach the server. Requires `temporal server start-dev` running locally (see
# the root .env.local.example for CLI install + key generation).
# TEMPORAL_ENCRYPTION_KEY must be the SAME base64 value used by the Next app.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_ENCRYPTION_KEY=               # base64 32-byte key; MUST match the app's
# TEMPORAL_TLS_CERT=                   # base64 client cert (Cloud only)
# TEMPORAL_TLS_KEY=                    # base64 client key  (Cloud only)

# TUNABLES (optional)
# EVAL_AGENT_FANOUT_CONCURRENCY: in-run cap on live agent-invocation fan-out for a scheduled
# eval run whose Connection is an agent (one Activity per input row). Default 5; bounds load on
# the customer endpoint / managed LLM. Resolved in the eval-run Activity (Node) and threaded to
# the Temporal workflow, so it never reads env from the deterministic sandbox.
# EVAL_AGENT_FANOUT_CONCURRENCY=5
