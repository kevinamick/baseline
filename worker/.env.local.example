# Copy this file to worker/.env.local and fill in the values.
#
# LOCAL SUPABASE (recommended for development)
# Run `npm run db:start` from the repo root, then copy the service_role key below.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=            # copy from `supabase start` output

# LLM
ANTHROPIC_API_KEY=sk-ant-...
LLM_PROVIDER=anthropic
# ANTHROPIC_MODEL=claude-opus-4-7     # optional override

# EMAIL (Resend)
RESEND_API_KEY=re_...
RESEND_FROM=evals@yourdomain.com

# APP
APP_URL=http://localhost:3000
