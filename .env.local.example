# Copy this file to .env.local and fill in the values.
#
# LOCAL SUPABASE (recommended for development)
# Run `npm run db:start` once, then copy the printed anon/service_role keys below.
# The URL and DB port are fixed by supabase/config.toml.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # copy from `supabase start` output
SUPABASE_SERVICE_ROLE_KEY=            # copy from `supabase start` output

# AUTH
# Authentication is Supabase Auth — no separate provider keys. The Supabase vars
# above cover it. Local sign-up confirmation emails are delivered to Mailpit (see
# the EMAIL section); social sign-in is configured under SOCIAL / OAUTH below.

# STRIPE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# One price id per paid plan (see src/lib/billing/plans.ts). The plan slug
# resolves to one of these server-side; the client never supplies a price id.
STRIPE_PRICE_BUILDER=price_...
STRIPE_PRICE_SCALE=price_...
STRIPE_WEBHOOK_SECRET=                # filled automatically on first `npm run dev` (see SETUP.md)

# APP
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SOCIAL / OAUTH (optional)
# Google + GitHub sign-in are wired end-to-end but disabled by default so local
# `supabase start` works offline. To turn a provider on:
#   1. create an OAuth app with the provider, using callback
#      <NEXT_PUBLIC_SUPABASE_URL>/auth/v1/callback,
#   2. fill its client id/secret below,
#   3. set enabled = true for it in supabase/config.toml,
#   4. add it to NEXT_PUBLIC_OAUTH_PROVIDERS so its button appears in the UI.
NEXT_PUBLIC_OAUTH_PROVIDERS=            # comma-separated, e.g. "google,github"
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=

# EMAIL
# Sender for app transactional email (org invites). In dev, mail is delivered to
# local Mailpit over SMTP (127.0.0.1:54325) — no Resend key needed. In production
# set RESEND_API_KEY; see src/lib/email/send.ts.
EMAIL_FROM=Baseline <noreply@baseline.app>
RESEND_API_KEY=                       # production only; dev uses Mailpit SMTP

# TEMPORAL (optional — the optimization loop's durable orchestration; ADR-0006)
# Unset → the app/worker run exactly as before (pgmq/pg_cron only). To try it locally:
#   1. install the CLI: `curl -sSf https://temporal.download/cli.sh | sh`
#   2. run the dev server (Postgres + Web UI on :8233): `temporal server start-dev`
#   3. generate ONE encryption key shared by the app and worker, and paste the same
#      base64 value into TEMPORAL_ENCRYPTION_KEY in BOTH .env.local files:
#        node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Address/namespace/TLS default to the local dev server; Cloud is the same vars + certs.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_ENCRYPTION_KEY=               # base64 32-byte key; MUST match the worker's
# TEMPORAL_TLS_CERT=                   # base64 client cert (Cloud only)
# TEMPORAL_TLS_KEY=                    # base64 client key  (Cloud only)

# TELEMETRY (all optional — app no-ops when empty)
# PostHog covers product analytics, logs, and error tracking (server + client).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
