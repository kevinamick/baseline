# Copy this file to .env.local and fill in the values.
#
# LOCAL SUPABASE (recommended for development)
# Run `npm run db:start` once, then copy the printed anon/service_role keys below.
# The URL and DB port are fixed by supabase/config.toml.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # copy from `supabase start` output
SUPABASE_SERVICE_ROLE_KEY=            # copy from `supabase start` output

# AUTH
# There is no sign-in (ADR-0020): whoever opens the app is the Local Workspace's
# Contributor. Nothing to configure.

# LLM PROVIDER KEYS (at least one)
# The worker judges and optimizes on these; the app reads the same vars to know a
# provider is usable. A key pasted under Settings → Provider keys overrides the env
# var for that provider. Keep them identical to worker/.env.local.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=

# APP
# The canonical public origin. Single source of truth for absolute links AND for SEO: metadataBase, canonical
# URLs, hreflang alternates, sitemap.xml, and robots.txt all derive from it
# (see src/lib/site-url.ts). MUST be the real https origin in staging/prod — if it
# falls back to localhost there, every canonical/OG/sitemap URL is wrong.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# EMAIL
# Run-notification email is sent by the worker (worker/.env.local.example); these
# app-side vars are kept for parity.
EMAIL_FROM=Baseline <noreply@baseline.app>
RESEND_API_KEY=                       # production only; dev uses Mailpit SMTP

# TEMPORAL (REQUIRED — the sole executor for eval + optimization runs; ADR-0006, #123)
# Temporal is mandatory: the app starts eval + optimization workflows through it, and the
# worker refuses to run without a registered Temporal worker. To run locally:
#   1. install the CLI: `curl -sSf https://temporal.download/cli.sh | sh`
#   2. run the dev server (Postgres + Web UI on :8233): `temporal server start-dev`
#   3. generate ONE encryption key shared by the app and worker, and paste the same
#      base64 value into TEMPORAL_ENCRYPTION_KEY in BOTH .env.local files:
#        node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Address/namespace/TLS default to the local dev server; Cloud is the same vars + certs.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_ENCRYPTION_KEY=               # base64 32-byte key; MUST match the worker's
# TEMPORAL_TLS_CERT=                   # base64 client cert (Cloud only)
# TEMPORAL_TLS_KEY=                    # base64 client key  (Cloud only)

# TELEMETRY (all optional — app no-ops when empty)
# PostHog covers product analytics, logs, and error tracking (server + client).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Server-side PostHog key/host (logs + error tracking), read at request time.
# Mirrors the worker's own POSTHOG_KEY/POSTHOG_HOST (worker/.env.local.example).
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# SEO (optional)
# Google Search Console verification token — the content="…" value from GSC's
# "HTML tag" verification method. When set, a <meta name="google-site-verification">
# is emitted site-wide; absent otherwise. Set in production once you verify the domain.
GOOGLE_SITE_VERIFICATION=
# GA4 Measurement ID (G-XXXXXXXXXX) from the property's Web data stream (#448).
# Build-time inlined like every NEXT_PUBLIC_* var, so setting it needs a rebuild.
# Unset (the default here) is the tag's OFF switch for local/e2e/staging — with
# it unset, src/app/_components/google-analytics.tsx renders nothing at all,
# regardless of cookie consent. When it IS set, the tag still only loads after
# the visitor accepts analytics (src/lib/consent/cookie.ts) — see AGENTS.md.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
